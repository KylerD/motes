# Cookieless PostHog milestones (see README.md). Analytics stay off unless both are set at build time.
# The PostHog project needs Cookieless tracking on (Settings › Web analytics) or it discards the events.
VITE_POSTHOG_KEY=phc_your_project_token
# PostHog's host, or a proxy path such as /ingest on motes.sh.
VITE_POSTHOG_HOST=https://eu.i.posthog.com
